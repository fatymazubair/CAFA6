    {
      "cell_type": "code",
      "source": [
        "# Even smaller: 100 most frequent terms, plus a subsample of training rows\n",
        "top_n = 100\n",
        "top_indices = np.argsort(term_freq_filtered)[-top_n:]\n",
        "\n",
        "Y_train_tiny = Y_train[:, top_indices]\n",
        "Y_val_tiny = Y_val[:, top_indices]\n",
        "\n",
        "# Subsample training rows too, just to prove the pipeline works end-to-end fast\n",
        "subsample_size = 10000\n",
        "idx = np.random.RandomState(42).choice(X_train.shape[0], subsample_size, replace=False)\n",
        "X_train_sub = X_train[idx]\n",
        "Y_train_sub = Y_train_tiny[idx]\n",
        "\n",
        "print(X_train_sub.shape, Y_train_sub.shape)"
