    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "\n",
        "def compute_weighted_fmax(y_true, y_proba, weights, thresholds=np.arange(0.01, 1.0, 0.01)):\n",
        "    best_f = 0\n",
        "    best_t = 0\n",
        "    for t in thresholds:\n",
        "        y_pred = (y_proba >= t).astype(int)\n",
        "\n",
        "        tp_weighted = ((y_pred * y_true) * weights).sum()\n",
        "        pred_weighted = (y_pred * weights).sum()\n",
        "        true_weighted = (y_true * weights).sum()\n",
        "\n",
        "        precision = tp_weighted / pred_weighted if pred_weighted > 0 else 0\n",
        "        recall = tp_weighted / true_weighted if true_weighted > 0 else 0\n",
        "\n",
        "        if precision + recall > 0:\n",
        "            f = 2 * precision * recall / (precision + recall)\n",
        "            if f > best_f:\n",
        "                best_f = f\n",
        "                best_t = t\n",
        "\n",
        "    return best_f, best_t\n",
        "\n",
        "# Get prediction probabilities (not just 0/1) for proper thresholding\n",
        "Y_proba = np.array([est.predict_proba(X_val)[:, 1] for est in clf_tiny.estimators_]).T\n",
        "\n",
        "fmax, best_threshold = compute_weighted_fmax(Y_val_tiny, Y_proba, weights_100)\n",
        "print(f\"Fmax: {fmax:.3f}\")\n",
        "print(f\"Best threshold: {best_threshold:.2f}\")\n"
      ],
