    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "\n",
        "# Pick the 500 most common terms (by frequency in training set)\n",
        "term_freq_filtered = Y_train.sum(axis=0)\n",
        "top_n = 500\n",
        "top_indices = np.argsort(term_freq_filtered)[-top_n:]\n",
        "\n",
        "Y_train_small = Y_train[:, top_indices]\n",
        "Y_val_small = Y_val[:, top_indices]\n",
        "\n",
        "print(Y_train_small.shape, Y_val_small.shape)\n"
      ],
